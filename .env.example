# --- Gemini / LLM ---------------------------------------------------------
GEMINI_API_KEY=
# The Gemini model to use, e.g. gemini-2.0-flash. Never hard-coded in code.
GEMINI_MODEL=

# --- Agent behaviour --------------------------------------------------
# Hard cap on tool-call iterations per agent turn, to prevent runaway loops.
MAX_AGENT_ITERATIONS=8

# --- Speech-to-text (Phase 2) ------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# int8 (CPU-friendly default) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8
# ISO-639-1 language code; leave blank for auto-detect (less reliable on short clips)
WHISPER_LANGUAGE=en
# Context that can help recognize names and domain terms; leave blank to disable
WHISPER_INITIAL_PROMPT=The user's name is Atharva. This is a conversation with an AI assistant called ALFRED.

# --- Text-to-speech (ElevenLabs) ----------------------------------------
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Database (Phase 4+) ---------------------------------------------
# Falls back to a local SQLite file if unset -- fine for Phase 1/2/3.
DATABASE_URL=postgresql://alfred:alfred@localhost:5432/alfred

# --- App -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
