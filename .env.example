# --- Gemini / LLM ---------------------------------------------------------
GEMINI_API_KEY=
# The Gemini model to use, e.g. gemini-2.0-flash. Never hard-coded in code.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=3

# --- Agent behaviour --------------------------------------------------
# Hard cap on tool-call iterations per agent turn, to prevent runaway loops.
MAX_AGENT_ITERATIONS=8

# --- Workflows (Phase 5) -------------------------------------------------
# Most tasks one plan may contain.
MAX_WORKFLOW_TASKS=15
# Extra attempts after a transient task failure (rate limit, overload, unreachable service). 0 = never retry.
# A task that already changed something (saved a note, set a reminder) is never retried automatically.
MAX_TASK_RETRIES=2
WORKFLOW_RETRY_DELAY_SECONDS=1.0
# Seconds one run may take before it stops starting new tasks; 0 = no limit.
WORKFLOW_EXECUTION_TIMEOUT=0
# Independent read-only tasks that may run at once; 1 = strictly sequential (recommended).
WORKFLOW_CONCURRENCY=1
# When chat starts a workflow, seconds the reply waits for it before carrying on in the background.
WORKFLOW_TOOL_WAIT_SECONDS=45
# MEDIUM-permission actions (create a note, create/delete a reminder) ask first.
# HIGH actions (delete a note) always ask, whatever this is set to.
REQUIRE_MEDIUM_CONFIRMATION=true
# IANA timezone used to read times like "tomorrow at 9am" and to show reminders.
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Speech-to-text (Phase 2) ------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# int8 (CPU-friendly default) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8
# ISO-639-1 language code; leave blank for auto-detect (less reliable on short clips)
WHISPER_LANGUAGE=en
# Context that can help recognize names and domain terms; leave blank to disable
WHISPER_INITIAL_PROMPT=The user's name is Atharva. This is a conversation with an AI assistant called ALFRED.

# --- Text-to-speech (ElevenLabs) ----------------------------------------
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Storage and files (Phase 3) ----------------------------------------
# The SQLite database (notes, reminders, document index) and uploaded files
# live under this directory. Memory, tasks and conversations live in PostgreSQL (below).
ALFRED_DATA_DIR=./data
MAX_UPLOAD_MB=20
SEARCH_MAX_RESULTS=5

# --- PostgreSQL (Phase 4: persistent memory) ----------------------------
# Either one connection URL ...
DATABASE_URL=postgresql://alfred:change_me@localhost:5432/alfred
# ... or the separate parts (used only when DATABASE_URL is empty):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=alfred
# POSTGRES_USER=alfred
# POSTGRES_PASSWORD=
# Leave both unset (or MEMORY_ENABLED=false) to run without memory, exactly like Phase 3.
MEMORY_ENABLED=true
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=5
# Apply pending migrations automatically on startup (python -m app.database.migrator does it by hand).
DB_AUTO_MIGRATE=true
# Only needed to run the PostgreSQL tests: a DISPOSABLE database whose alfred tables get emptied.
# TEST_DATABASE_URL=postgresql://alfred:change_me@localhost:5432/alfred_test

# --- Memory behaviour (Phase 4) ------------------------------------------
# Short-term memory: recent messages / characters of the current chat sent to Gemini each turn.
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=12000
# Long-term retrieval: at most this many memories per turn; weakest accepted match (0..1) when the
# request clearly refers to earlier context (requests without such cues need a match of at least 0.5).
MEMORY_MAX_RETRIEVED=5
MEMORY_MIN_SCORE=0.15
# Unused memories of importance <= 2 older than this many days are archived at startup.
MEMORY_ARCHIVE_AFTER_DAYS=180
# Also ask Gemini to extract memories after each turn (one extra model call per turn).
MEMORY_LLM_EXTRACTION=false

# --- App -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
