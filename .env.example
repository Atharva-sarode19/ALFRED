# --- Gemini / LLM ---------------------------------------------------------
GEMINI_API_KEY=
# The Gemini model to use, e.g. gemini-2.0-flash. Never hard-coded in code.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=3

# --- Agent behaviour --------------------------------------------------
# Hard cap on tool-call iterations per agent turn, to prevent runaway loops.
MAX_AGENT_ITERATIONS=8
# MEDIUM-permission actions (create a note, create/delete a reminder) ask first.
# HIGH actions (delete a note) always ask, whatever this is set to.
REQUIRE_MEDIUM_CONFIRMATION=true
# IANA timezone used to read times like "tomorrow at 9am" and to show reminders.
DEFAULT_TIMEZONE=UTC

# --- Speech-to-text (Phase 2) ------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# int8 (CPU-friendly default) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8
# ISO-639-1 language code; leave blank for auto-detect (less reliable on short clips)
WHISPER_LANGUAGE=en
# Context that can help recognize names and domain terms; leave blank to disable
WHISPER_INITIAL_PROMPT=The user's name is Atharva. This is a conversation with an AI assistant called ALFRED.

# --- Text-to-speech (ElevenLabs) ----------------------------------------
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Storage and files (Phase 3) ----------------------------------------
# The SQLite database (notes, reminders, document index) and uploaded files
# live under this directory until Phase 4 moves storage to PostgreSQL.
ALFRED_DATA_DIR=./data
MAX_UPLOAD_MB=20
SEARCH_MAX_RESULTS=5

# --- Database (Phase 4+) ---------------------------------------------
# Not used yet: Phase 3 stores data in SQLite under ALFRED_DATA_DIR.
DATABASE_URL=postgresql://alfred:alfred@localhost:5432/alfred

# --- App -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
